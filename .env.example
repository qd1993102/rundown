# Rundown 环境变量配置
# 复制此文件为 .env 并填入真实值
# 兼容旧名 GARMIN_EMAIL / GARMIN_PASSWORD，推荐用新的 RUNDOWN_ 前缀

# ── 必填（Garmin 和 Coros 通用，支持邮箱或手机号）──
NEURUN_ACCOUNT=your_email_or_phone
NEURUN_PASSWORD=your_password

# ── 数据源: garmin（默认）| coros ──
NEURUN_PROVIDER=garmin

# ── 数据库 ──
NEURUN_DATA_DIR=./data
NEURUN_DB_PATH=./data/rundown_data.db
NEURUN_SYNC_DAYS=30
# Web 单进程同步容量：同时执行 4 个，执行中与排队中最多 100 个不同用户
NEURUN_SYNC_MAX_CONCURRENCY=4
NEURUN_SYNC_MAX_PENDING=100
NEURUN_LOG_LEVEL=INFO

# ── Garmin 专用 ──
# GARMIN_DOMAIN=garmin.com
# GARMIN_TOKEN_DIR=~/.garmy

# ── Coros 专用 ──
# 无需额外配置，邮箱密码同上

# ── AI 教练（可选）──
DEEPSEEK_API_KEY=sk-your-deepseek-api-key

# ── Web 邀请注册（可选，默认 ./data/invite-codes.json）──
# NEURUN_INVITE_CODES_FILE=./data/invite-codes.json
# NEURUN_ENABLE_ADMIN_TOOLS=false
